{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppSOFA macOS Application Security Feed v1",
  "type": "object",
  "required": ["FeedVersion", "Generated", "Applications"],
  "properties": {
    "FeedVersion": {"const": "1.0"},
    "Generated": {"type": "string", "format": "date-time"},
    "UpdateHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Name","BundleID","ApplicationPath","LatestVersion","MinimumSecureVersion","SecurityReleases"],
        "properties": {
          "Name":{"type":"string"},
          "BundleID":{"type":"string"},
          "ApplicationPath":{"type":"string"},
          "LatestVersion":{"type":"string"},
          "MinimumSecureVersion":{"type":["string","null"]},
          "SecurityReleases":{
            "type":"array",
            "items":{
              "type":"object",
              "required":["Version","MacVersions","ReleaseDate","CVEs","HighestSeverity","CISAKEVCount"],
              "properties":{
                "Version":{"type":"string"},
                "MacVersions":{"type":"array","items":{"type":"string"}},
                "ReleaseDate":{"type":"string","format":"date"},
                "SourceURL":{"type":["string","null"],"format":"uri"},
                "HighestSeverity":{"type":"string"},
                "CISAKEVCount":{"type":"integer","minimum":0},
                "CVEs":{"type":"array","items":{
                  "type":"object",
                  "required":["CVE","Severity","CISAKEV"],
                  "properties":{
                    "CVE":{"type":"string","pattern":"^CVE-[0-9]{4}-[0-9]+$"},
                    "Severity":{"enum":["Critical","High","Medium","Low","Unknown"]},
                    "CISAKEV":{"type":"boolean"}
                  },
                  "additionalProperties":false
                }}
              },
              "additionalProperties":false
            }
          }
        },
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":false
}
